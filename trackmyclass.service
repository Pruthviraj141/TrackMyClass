[Unit]
Description=TrackMyClass FastAPI Service
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/TrackMyClass
Environment="PATH=/home/ubuntu/TrackMyClass/venv/bin"
EnvironmentFile=/home/ubuntu/TrackMyClass/.env
ExecStart=/home/ubuntu/TrackMyClass/venv/bin/gunicorn -k uvicorn.workers.UvicornWorker --bind 0.0.0.0:8000 --workers 4 --timeout 120 backend.main:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
