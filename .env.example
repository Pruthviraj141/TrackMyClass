# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password

# Session Security
SESSION_SECRET_KEY=generate_a_random_secure_string_here

# Deep Learning Settings (optional override)
# DEVICE=cpu
# SIMILARITY_THRESHOLD=0.80

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# Firebase Credentials (if using Firebase)
# FIREBASE_CREDENTIALS_JSON='{"type": "service_account", "project_id": "..."}'
# OR
# FIREBASE_CREDENTIALS_PATH=./firebase.json
